<Label>:
    color: 0.1, 0.1, 0.1, 1
    
<Button>:
    color: 1, 1, 1, 1
    background_normal: ''
    canvas.before:
        Color:
            rgba: self.background_color if self.background_color else (0.2, 0.6, 0.8, 1)
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [15]

<Camera>:
    canvas.before:
        Color:
            rgba: 0.9, 0.9, 0.9, 1
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [10]

<Image>:
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.95, 1
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [5]